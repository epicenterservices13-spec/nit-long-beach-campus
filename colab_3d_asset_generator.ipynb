      "source": [
        "# 2. Procedural Generation: Multi-Tiered Long Beach Engineering Pagoda\n",
        "import trimesh\n",
        "import numpy as np\n",
        "\n",
        "def create_pagoda_tier(width, height, roof_overhang):\n",
        "    base = trimesh.creation.box(extents=[width, height, width])\n",
        "    roof = trimesh.creation.cone(radius=width * (1.0 + roof_overhang), height=height * 0.8, sections=4)\n",
        "    roof.apply_translation([0, height * 0.5 + height * 0.4, 0])\n",
        "    return trimesh.boolean.union([base, roof])\n",
        "\n",
        "print('[+] Generative 3D Asset Generator Operational on Colab GPU.')"
      ]
    }
